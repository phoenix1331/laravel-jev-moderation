{
    "name": "phoenix1331/laravel-jev-moderation",
    "description": "Confidence-aware content moderation for Laravel: classify any Eloquent model with Jev and route each item to passed, flagged for human review, or blocked, using per-category thresholds.",
    "keywords": [
        "laravel",
        "moderation",
        "content-moderation",
        "jev",
        "typesafe",
        "ai",
        "classification",
        "trust-and-safety",
        "eloquent",
        "ugc",
        "review-queue",
        "spam"
    ],
    "homepage": "https://phoenix1331.github.io/laravel-jev-moderation",
    "license": "MIT",
    "authors": [
        {
            "name": "Darren Williams",
            "homepage": "https://github.com/phoenix1331"
        }
    ],
    "support": {
        "issues": "https://github.com/phoenix1331/laravel-jev-moderation/issues",
        "source": "https://github.com/phoenix1331/laravel-jev-moderation"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.6|^11.3",
        "pestphp/pest": "^4.1|^5.3",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Phoenix1331\\JevModeration\\": "src/",
            "Phoenix1331\\JevModeration\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phoenix1331\\JevModeration\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phoenix1331\\JevModeration\\JevModerationServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "check": [
            "@lint:test",
            "@analyse",
            "@test:coverage"
        ]
    },
    "scripts-descriptions": {
        "lint": "Fix code style with Pint",
        "lint:test": "Check code style with Pint without changing files",
        "analyse": "Run Larastan at max level",
        "test": "Run the Pest suite",
        "test:coverage": "Run the Pest suite with the 90% coverage gate on src/",
        "check": "Run style check, static analysis and the coverage gate, in that order"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
